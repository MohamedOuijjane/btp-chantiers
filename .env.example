# Copier ce fichier en .env puis adapter les valeurs

# Administrateur de la base unique btp_db
POSTGRES_USER=btp
POSTGRES_PASSWORD=btp

# Un utilisateur par module, limité à son propre schéma
CHANTIERS_DB_PASSWORD=chantiers
TACHES_DB_PASSWORD=taches
OUVRIERS_DB_PASSWORD=ouvriers
MATERIAUX_DB_PASSWORD=materiaux
AUTH_DB_PASSWORD=auth

# Authentification (ADR-0006) : OBLIGATOIRES, docker compose refuse de démarrer sans elles.
# Secret de signature des jetons (HS256), au moins 32 caractères. En dehors de la démo,
# en générer un nouveau : openssl rand -base64 48
JWT_SECRET=demo-btp-chantiers-changer-ce-secret-hors-demo-2026
# Mot de passe des 4 comptes de démonstration de la maquette (voir README)
DEMO_MOT_DE_PASSE=chantier2026

# TEMPORAIRE : MySQL, jusqu'à la migration de Matériaux vers PostgreSQL
MYSQL_USER=btp
MYSQL_PASSWORD=btp
MYSQL_ROOT_PASSWORD=root

GATEWAY_PORT=8080
