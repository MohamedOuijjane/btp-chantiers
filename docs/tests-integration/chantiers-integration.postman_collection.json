              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Centre de santé Inezgane - réhabilitation (Postman)\",\n  \"adresse\": \"Avenue Mokhtar Soussi, Inezgane\",\n  \"client\": \"Délégation provinciale de la Santé\",\n  \"dateDebut\": \"2026-07-01\",\n  \"dateFinPrevue\": \"2026-12-20\",\n  \"budget\": 1650000.0\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 409', () => pm.response.to.have.status(409));",
