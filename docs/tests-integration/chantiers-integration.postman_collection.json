              ],
              "path": [
                "api",
                "chantiers",
                "{{chantierId}}"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Résidence Al Amal - 48 logements (Postman)\",\n  \"adresse\": \"Lotissement Al Amal, lot 112, Hay Mohammadi, Agadir\",\n  \"client\": \"Al Omrane Souss-Massa\",\n  \"dateDebut\": \"2026-09-01\",\n  \"dateFinPrevue\": \"2027-12-31\",\n  \"budget\": 18900000.0,\n  \"statut\": \"SUSPENDU\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('SUSPENDU', () => pm.expect(pm.response.json().statut).to.eql('SUSPENDU'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Tâches refuse une tâche sur un chantier suspendu (409)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{gateway}}/api/taches",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "api",
                "taches"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chantierId\": {{chantierId}},\n  \"titre\": \"Fondations et semelles\",\n  \"dateDebut\": \"2026-12-01\",\n  \"dateFin\": \"2026-12-15\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 409', () => pm.response.to.have.status(409));",
                  "pm.test('Motif : chantier suspendu', () => pm.expect(JSON.stringify(pm.response.json())).to.include('suspendu'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Créer un second chantier",
          "request": {
