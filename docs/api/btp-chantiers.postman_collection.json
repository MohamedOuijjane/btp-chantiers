    },
    {
      "name": "Matériaux (SOAP)",
      "item": [
        {
          "name": "AjouterMateriau",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{gateway}}/ws",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "ws"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:m=\"http://btp.uiz.ma/materiaux\">\n  <soapenv:Body>\n    <m:AjouterMateriauRequest><m:materiau><m:reference>CIM-01</m:reference><m:nom>Ciment CPJ45</m:nom><m:unite>sac</m:unite><m:stock>100</m:stock><m:seuilAlerte>20</m:seuilAlerte></m:materiau></m:AjouterMateriauRequest>\n  </soapenv:Body>\n</soapenv:Envelope>"
            }
          }
        },
        {
          "name": "ListerMateriaux",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{gateway}}/ws",
              "host": [
