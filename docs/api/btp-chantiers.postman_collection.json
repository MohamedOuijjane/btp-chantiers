                "key": "Content-Type",
                "value": "text/xml"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:m=\"http://btp.uiz.ma/materiaux\">\n  <soapenv:Body>\n    <m:ListerMateriauxRequest></m:ListerMateriauxRequest>\n  </soapenv:Body>\n</soapenv:Envelope>"
            }
          }
        },
        {
          "name": "VerifierStock",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{gateway}}/ws",
              "host": [
                "{{gateway}}"
              ],
              "path": [
